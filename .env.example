# Copy this file to .env and fill in your key.
# Never commit your real .env file.

# Required for the default provider (Ollama cloud):
OLLAMA_API_KEY=your_ollama_api_key_here

# Optional overrides:
# TESTGEN_PROVIDER=ollama        # ollama | mock
# TESTGEN_MODEL=qwen3-coder-next
# TESTGEN_MAX_ITERATIONS=5
# TESTGEN_COVERAGE_THRESHOLD=80
# OLLAMA_HOST=https://ollama.com
